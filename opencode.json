{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".cursor/rules/taller.mdc", ".cursor/rules/estructura.mdc"],
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?features=database,docs,development",
      "enabled": true
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.pem": "deny",
      "**/*.pem": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "*.env.local*": "deny",
      "*.env.*.local*": "deny",
      "*.pem*": "deny"
    }
  }
}
